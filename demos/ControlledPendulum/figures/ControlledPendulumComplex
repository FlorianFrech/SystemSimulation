// System: Complex Coupled Pendulum System
digraph {
	graph [bgcolor=white compound=true esep=0 fontname="Helvetica-Bold" fontsize=18 label="Complex Coupled Pendulum System" labelloc=t margin=0.2 nodesep=0.8 pad=0.5 rankdir=LR ranksep=0.8 sep=0 splines=true]
	node [fillcolor=white fontname=Helvetica fontsize=10 margin="0.05,0.05" shape=plaintext style=""]
	edge [arrowhead=vee arrowsize=0.7 arrowtail=none color="#111827" dir=forward fontname=Helvetica fontsize=10 labelangle=45 labelfontcolor="#374151" minlen=1.2 penwidth=1.2]
	subgraph cluster_legend {
		bgcolor="#f9fafb" color="#d1d5db" fontname="Helvetica-Bold" fontsize=10 label=Legend margin=8 penwidth=1.5 rank=sink style=rounded
		legend_node [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="2">
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>Edges:</B></FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">───&gt; Data flow</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#0b84ff">┄┄┄o Event connection</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>Ports:</B></FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#ef4444"><B>red</B></FONT> Direct feedthrough</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#0b84ff"><B>blue</B></FONT> Event port</TD></TR>
            </TABLE>
            > fontsize=8 shape=plaintext]
	}
	subgraph cluster_Reference {
		bgcolor="#dbeafe" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Reference margin=12 penwidth=2 style=rounded
		ref [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD></TD><TD><B>ref</B><BR/><FONT POINT-SIZE="8">#0</FONT></TD><TD PORT="q_ref">q_ref</TD></TR></TABLE>>]
	}
	subgraph cluster_Sensors {
		bgcolor="#dcfce7" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Sensors margin=12 penwidth=2 style=rounded
		sensor_ref [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD PORT="q">q</TD><TD><B>sensor_ref</B><BR/><FONT POINT-SIZE="8">#1</FONT></TD><TD PORT="U_q"><FONT COLOR="#ef4444"><B>U_q</B></FONT></TD></TR></TABLE>>]
		sensor_state [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD PORT="q">q</TD><TD><B>sensor_state</B><BR/><FONT POINT-SIZE="8">#1</FONT></TD><TD PORT="U_q"><FONT COLOR="#ef4444"><B>U_q</B></FONT></TD></TR></TABLE>>]
	}
	subgraph cluster_Control {
		bgcolor="#fee2e2" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Control margin=12 penwidth=2 style=rounded
		pid [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="ref">ref</TD></TR><TR><TD PORT="resetI"><FONT COLOR="#0b84ff"><B>resetI</B></FONT></TD></TR><TR><TD PORT="y">y</TD></TR></TABLE></TD><TD><B>pid</B><BR/><FONT POINT-SIZE="8">#2</FONT></TD><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="I_out">I_out</TD></TR><TR><TD PORT="u"><FONT COLOR="#ef4444"><B>u</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>]
	}
	subgraph cluster_Actuator {
		bgcolor="#fef3c7" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Actuator margin=12 penwidth=2 style=rounded
		drive_coupled [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="alpha">alpha</TD></TR><TR><TD PORT="omega">omega</TD></TR><TR><TD PORT="phi">phi</TD></TR><TR><TD PORT="u_control">u_control</TD></TR></TABLE></TD><TD><B>drive_coupled</B><BR/><FONT POINT-SIZE="8">#0</FONT></TD><TD PORT="torque"><FONT COLOR="#ef4444"><B>torque</B></FONT></TD></TR></TABLE>>]
	}
	subgraph cluster_Plant {
		bgcolor="#e5e7eb" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Plant margin=12 penwidth=2 style=rounded
		pendulum [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD PORT="torque">torque</TD><TD><B>pendulum</B><BR/><FONT POINT-SIZE="8">#0</FONT></TD><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="alpha"><FONT COLOR="#ef4444"><B>alpha</B></FONT></TD></TR><TR><TD PORT="omega">omega</TD></TR><TR><TD PORT="q">q</TD></TR></TABLE></TD></TR></TABLE>>]
	}
	ref -> sensor_ref [label="[rad]" color="#111827" headclip=true headport="q:w" style=solid tailclip=true tailport="q_ref:e"]
	pendulum -> sensor_state [label="[rad]" color="#111827" headclip=true headport="q:w" style=solid tailclip=true tailport="q:e"]
	sensor_ref -> pid [label="[V]" color="#111827" headclip=true headport="ref:w" style=solid tailclip=true tailport="U_q:e"]
	sensor_state -> pid [label="[V]" color="#111827" headclip=true headport="y:w" style=solid tailclip=true tailport="U_q:e"]
	pid -> drive_coupled [label="" color="#111827" headclip=true headport="u_control:w" style=solid tailclip=true tailport="u:e"]
	drive_coupled -> pendulum [label="[m·N]" color="#111827" headclip=true headport="torque:w" style=solid tailclip=true tailport="torque:e"]
	pendulum -> drive_coupled [label="[rad]" color="#111827" headclip=true headport="phi:w" style=solid tailclip=true tailport="q:e"]
	pendulum -> drive_coupled [label="[rad/s]" color="#111827" headclip=true headport="omega:w" style=solid tailclip=true tailport="omega:e"]
	pendulum -> drive_coupled [label="[rad/s²]" color="#111827" headclip=true headport="alpha:w" style=solid tailclip=true tailport="alpha:e"]
}
