// System: Controlled Pendulum System
digraph {
	graph [bgcolor=white compound=true esep=0 fontname=Helvetica fontsize=16 label="Controlled Pendulum System" labelloc=t margin=0.2 nodesep=1 pad=0.75 rankdir=LR ranksep=0.75 sep=0 smoothType=graph_dist splines=true]
	node [color="#3b82f6" fillcolor=white fontname=Helvetica fontsize=10 height=0.7 margin="0.12,0.1" penwidth=1.5 shape=record style="rounded,filled" width=1.5]
	edge [arrowhead=open arrowsize=0.5 arrowtail=none color="#111827" dir=forward fontname=Helvetica fontsize=10 labelangle=45 labelfontcolor="#374151" minlen=1.4 penwidth=1 style=solid]
	subgraph cluster_Input {
		bgcolor=white color="#9ca3af" fontname=Helvetica fontsize=10 label=Input style=rounded
		ref [label="{ ref | { <q_ref> q_ref } }" xlabel="#1"]
	}
	subgraph cluster_Sensors {
		bgcolor="#dcfce7" color="#9ca3af" fontname=Helvetica fontsize=10 label=Sensors style=rounded
		sensor_ref [label="{ { <q> q } | sensor_ref | { <U_q> U_q } }" xlabel="#2"]
		sensor_state [label="{ { <q> q } | sensor_state | { <U_q> U_q } }" xlabel="#1"]
	}
	subgraph cluster_Control {
		bgcolor="#fee2e2" color="#9ca3af" fontname=Helvetica fontsize=10 label=Control style=rounded
		pid [label="{ { <ref> ref | <y> y } | pid | { <u> u } }" xlabel="#3"]
	}
	subgraph cluster_Actuator {
		bgcolor="#fef3c7" color="#9ca3af" fontname=Helvetica fontsize=10 label=Actuator style=rounded
		drive [label="{ { <omega> omega | <u_control> u_control } | drive | { <torque> torque } }" xlabel="#4"]
	}
	subgraph cluster_Plant {
		bgcolor="#e5e7eb" color="#9ca3af" fontname=Helvetica fontsize=10 label=Plant style=rounded
		pendulum [label="{ { <torque> torque } | pendulum | { <omega_state> omega_state | <q_state> q_state } }" xlabel="#5"]
	}
	ref -> sensor_ref [label="[rad]" color="#111827" headclip=true headport="q:w" style=solid tailclip=true tailport="q_ref:e"]
	pendulum -> sensor_state [label="[rad] delay(1)" color="#6b7280" headclip=true headport="q:w" style=dashed tailclip=true tailport="q_state:e"]
	sensor_ref -> pid [label="[V]" color="#111827" headclip=true headport="ref:w" style=solid tailclip=true tailport="U_q:e"]
	sensor_state -> pid [label="[V]" color="#111827" headclip=true headport="y:w" style=solid tailclip=true tailport="U_q:e"]
	pid -> drive [label="[None]" color="#111827" headclip=true headport="u_control:w" style=solid tailclip=true tailport="u:e"]
	drive -> pendulum [label="[m·N]" color="#111827" headclip=true headport="torque:w" style=solid tailclip=true tailport="torque:e"]
	pendulum -> drive [label="[rad/s] delay(1)" color="#6b7280" headclip=true headport="omega:w" style=dashed tailclip=true tailport="omega_state:e"]
}
