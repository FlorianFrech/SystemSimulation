within ControlledPendulum;

model TestDrive
  // Imports
  import Modelica.Constants.pi;
  import SI = Modelica.Units.SI;
  import Blocks = Modelica.Blocks;
  
  // Instantiate component
  ControlledPendulum.Drive drive;
  
  // Control Parameter
  Modelica.Blocks.Sources.Constant u_src(k=1);
  
  // Load speed omega_m (rad/s): ramp up over 5 to 50 rad/s
  Modelica.Blocks.Sources.Ramp omega_src(
    height = 50,
    duration = 5,
    offset = 0,
    startTime = 0);
    
  // Outputs
  Modelica.Blocks.Interfaces.RealOutput u_out(unit="V");
  Modelica.Blocks.Interfaces.RealOutput omega_out(unit="rad/s");
  Modelica.Blocks.Interfaces.RealOutput M_out(unit="N.m");
  Modelica.Blocks.Interfaces.RealOutput M_ss_out(unit="N.m") "Analytical steady-state torque";

protected
  // Analytical steady-state torque:
  // I_ss = (U - n/k_n)/R_M,  n = i_G*omega_m*30/pi  [rpm]
  // M_ss = eta_G*i_G*k_M*I_ss
  Real n_rpm(unit="1/min");
  SI.Voltage U;
  SI.Current I_ss;
  SI.Torque M_ss;

  // Tolerance for check (electrical time constant is ~L/R ≈ 0.8 ms, so 50 ms is plenty)
  parameter Real tol = 1e-3;
    
equation
  // Wire stimuli to the drive
  connect(u_src.y,      drive.u);
  connect(omega_src.y,  drive.omega_m);

  // Expose signals
  connect(u_src.y,  u_out);
  connect(omega_src.y, omega_out);
  connect(drive.M,  M_out);

  // Analytical steady-state expressions
  U      = drive.U_M * u_src.k;
  n_rpm  = (drive.i_G * omega_src.y) * 30 / pi;
  I_ss   = (U - n_rpm / drive.k_n) / drive.R_M;
  M_ss   = drive.eta_G * drive.i_G * drive.k_M * I_ss;

  // Expose analytical steady-state torque
  M_ss_out = M_ss;

  // Sampled assertion after transients
  when sample(0.05, 0.05) then
    // Allow a modest tolerance; tighten if needed
    assert( abs(M_out - M_ss) < tol,
      "Drive torque deviates from steady-state prediction. "
      + "Check parameters or stimulus timing.");
  end when;

  annotation (experiment(StartTime=0, StopTime=10, Interval=0.002));
end TestDrive;