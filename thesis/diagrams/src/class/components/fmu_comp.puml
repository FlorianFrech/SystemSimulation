@startuml FMUComponent
!include ../../includes/thesis_theme.puml
left to right direction

abstract class CoSimComponent {
    + initialize(t0)
    + do_step(t, dt)
    + evaluate_outputs(inputs, t)
    --
    # _initialize_component(t0)
    # _do_step_internal(t, dt)
    # _update_output_states(t)
}

class FMUComponent {
    + name: str
    - _path: str
    - _md: ModelDescription
    - _instance: FMU2Slave
    + direct_feedthrough
    --
    + set_inputs(signals, t)
    + get_outputs()
    + get_state() / set_state(state, t)
    --
    # _initialize_component(t0)
    # _do_step_internal(t, dt)
    # _update_output_states(t)
    + evaluate_outputs(inputs, t)
}

class ModelDescription <<fmpy>> {
    + modelVariables
    + outputs (ModelStructure)
    + coSimulation
}

class FMU2Slave <<fmpy>> {
    + instantiate()
    + setupExperiment / enter/exit InitializationMode
    + doStep(t, dt)
    + get*() / set*()
    + reset()
}

CoSimComponent <|-- FMUComponent
FMUComponent --> ModelDescription : parses once\n(construction)
FMUComponent --> FMU2Slave : owns\n(runtime)

' note top of FMUComponent
'   **Adapter** from an FMI 2.0
'   Co-Simulation FMU to the
'   CoSimComponent contract.
' end note

' note bottom of ModelDescription
'   Source of ports, parameters,
'   units, value references, and
'   direct-feedthrough dependencies.
' end note

' note bottom of FMU2Slave
'   Runtime proxy to the FMU
'   binary. All FMI calls are
'   batched per base type.
' end note

@enduml
