@startuml Port
!include ../../includes/thesis_theme.puml
left to right direction

enum PortType <<StrEnum>> {
    REAL
    INT
    BOOL
    STRING
    EVENT
}

enum Direction <<Literal>> {
    in
    out
}

class PortSpec {
    + name: str
    + type: PortType
    + direction: Direction
    + unit: optional unit
    --
    + validate_value(...)
    + compatible(...)
}

class PortState {
    + spec: PortSpec
    + value
    + t_last: float | None
    --
    + set(value, t=None)
    + get(as_unit=None)
}

PortSpec --> PortType : typed by
PortSpec --> Direction : direction
PortState *-- PortSpec : wraps

note top of PortSpec
  **Immutable** port contract:
  name, type, direction, optional unit
end note

note top of PortState
  **Mutable** runtime state:
  current value and
  last update timestamp
end note

@enduml
