@startuml System
!include ../../includes/thesis_theme.puml

left to right direction
skinparam nodesep 25
skinparam ranksep 45

' ============================================================================
' SYSTEM CLASS
' ============================================================================
class System {
    + name: str
    + t: float
    + is_initialized: bool
    --
    + algorithm: Algorithm
    + history: SystemHistory
    ==
    .. Registration ..
    + add_component(component)
    + add_connection(connection)
    + add_event_connection(connection)
    .. Algorithm ..
    + set_algorithm(algorithm)
    .. Lifecycle ..
    + initialize(t0)
    + run(t0, tf, dt)
    + reset()
    + get_history(): dict
}

' ============================================================================
' CONNECTION DATACLASSES (forced into one column)
' ============================================================================
together {
    abstract class CoSimComponent <<ABC>>

    class Connection <<dataclass>> {
        + src_comp, src_port: str
        + dst_comp, dst_port: str
        --
        + key(): tuple
    }

    class EventConnection <<dataclass>> {
        + src_comp, src_port: str
        + dst_comp, dst_port: str
        + direction: Optional[int]
        --
        + key(): tuple
        + event_name, target_comp: str
    }


    abstract class Algorithm <<ABC>> {
        + step(system, t, dt)
    }
}

' ============================================================================
' REFERENCED ABSTRACTIONS (forced into one column)
' ============================================================================
together {

}

' ============================================================================
' RELATIONS
' ============================================================================
System "1" o--> "*" CoSimComponent   : manages
System "1" o--> "*" Connection       : contains
System "1" o--> "*" EventConnection  : contains
System "1"  -->  "1" Algorithm       : delegates stepping

Connection      ..> CoSimComponent : references by name
EventConnection ..> CoSimComponent : references by name

@enduml
