@startuml Structural_Analysis_Pipeline

!include ../includes/thesis_theme.puml

top to bottom direction
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontColor #222222
}
skinparam ArrowThickness 1.3
skinparam nodesep 22
skinparam ranksep 28

rectangle "Registered system data\ncomponents\nconnections\ndirect_feedthrough" as Inputs #F7F7F7

rectangle "build_graphs()\ncreate graph metadata\napply active-output filter\ndetect SCC loop blocks" as Build #E8F5F5

rectangle "Structural metadata\ngraph\n_dag\ninput lookup maps\nalgebraic_loops" as Structural #FFFFFF

rectangle "compute_execution_order()\ncondense zero-delay SCCs\ncompute generations\ndelayed-producer pass" as Order #E8F5F5

rectangle "Schedule metadata\n_scc_index\nexecution_order\nexecution_idx" as Schedule #FFFFFF

rectangle "Initialization\nand master algorithms" as Consumers #F7F7F7

Inputs -down-> Build
Build -down-> Structural
Structural -right-> Order
Order -down-> Schedule
Schedule -down-> Consumers
Structural -[dashed]-> Consumers

@enduml
