@startuml Gauss_Seidel_Algorithm

!include ../includes/sequence_theme.puml

hide footbox

skinparam defaultFontSize 11
skinparam participantPadding 18
skinparam maxMessageSize 120

participant "Master" as M COLOR_FRAMEWORK
participant "Gen i" as G COLOR_SUBCLASS
participant "SCC\nsolver" as S COLOR_BASECLASS

== Interleaved Generation Pass ==

loop for gen in execution_order
    M -> G: _set_inputs_for_\ngeneration(gen, t)

    alt if gen contains loop
        M -> S: solve_algebraic_scc_\nijcsa(loop, t)
        S --> M: consistent inputs
    end

    M -> G: do_step(t, dt)\nfor all components
    G --> M: outputs stored\nat t + dt
end

' note right of M
' Later generations see fresh outputs
' from earlier generations within the same macro step.
' end note

@enduml
