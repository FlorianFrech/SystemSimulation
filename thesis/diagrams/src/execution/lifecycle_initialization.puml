@startuml CoSimComponent_Initialization

!include ../includes/sequence_theme.puml

hide footbox

participant "System"                 as Caller COLOR_FRAMEWORK
participant "Component\n(Sub Class)" as Sub    COLOR_SUBCLASS
participant "CoSimComponent\n(Base Class)" as Base COLOR_BASECLASS

== Initialization ==

Caller -> Base: **initialize(t0)**
activate Base

Base -> Base: Set initial time t = t0

Base -> Base: _initialize_ports_from_specs()
' note right
' Create PortState objects from input_specs/output_specs
' and register output ports in history
' end note

Base -> Base: _initialize_event_ports()
' note right
' Add event output ports for registered indicators
' end note

Base -> Sub: **_initialize_component(t0)**
activate Sub
note left: //abstract//\nLoad model, apply parameters,\nconfigure solver, set initial state
Sub --> Base
deactivate Sub

Base -> Base: _detect_direct_feedthrough()
' note right
' Probe algebraic dependencies via evaluate_outputs()
' end note

Base -> Sub: **_update_output_states(t0)**
activate Sub
note left: //abstract//\nWrite internal state\nto output ports
Sub --> Base
deactivate Sub

Base -> Base: _record_outputs(t0)
' Base -> Base: Set _is_initialized = True

Base --> Caller
deactivate Base

@enduml
