@startuml System_Initialization

!include ../includes/sequence_theme.puml

hide footbox

participant "User"        as User  COLOR_USER
participant "System"      as Sys   COLOR_FRAMEWORK
participant "Component A\n(Gen 0)" as CompA COLOR_SUBCLASS
participant "Component B\n(Gen 1)" as CompB COLOR_SUBCLASS

== Initialization ==

User -> Sys: **initialize(t0)**
activate Sys

Sys -> Sys: classify components & auto-select algorithm
Sys -> CompA: initialize ports & detect direct feedthrough
Sys -> CompB: initialize ports & detect direct feedthrough
Sys -> Sys: build_graphs() & compute_execution_order()

loop for each generation gen 

    Sys -> Sys: _set_inputs_for_generation(gen, t0)
    Sys -> CompA: **initialize(t0)**
    Sys -> Sys: resolve algebraic loops in gen
    Sys -> CompA: do_step(0, 0)
    note right: publishes output

end

Sys -> Sys: is_initialized = True
Sys --> User
deactivate Sys

@enduml