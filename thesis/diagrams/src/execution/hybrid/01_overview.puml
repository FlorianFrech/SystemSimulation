@startuml Hybrid_CoSimulation_Overview

!include ../includes/common_styling.puml

title Hybrid Co-Simulation Algorithm - High-Level Overview

participant "Master\nAlgorithm" as Master
box "Event Sources" #LightBlue
    participant "Source 1\n(rollback)" as Src1
    participant "Source 2\n(rollback)" as Src2
end box
participant "Event\nListener" as Listener

== Macro-Step: [t, t+dt] ==

note over Master
    **Initialize:**
    t_left = t
    t_right = t + dt
end note

group #LightGreen Sub-Stepping Loop [while t_left < t_right]
    
    group #FFE6CC Phase 1: Input Preparation
        Master -> Src1: Set inputs from connections
        activate Src1
        Src1 --> Master: inputs ready
        deactivate Src1
        
        Master -> Src2: Set inputs from connections
        activate Src2
        Src2 --> Master: inputs ready
        deactivate Src2
        
        Master -> Listener: Set inputs from connections
        activate Listener
        note right: **Inputs frozen**\nfor event detection
        Listener --> Master: inputs ready
        deactivate Listener
        
        opt Algebraic loops present
            Master -> Master: Solve algebraic loops\n(IJCSA iteration)
        end
    end
    
    group #E8F8F5 Phase 2: Event Detection
        note over Master
            **Goal:** Check if events occur
            in interval [t_left, t_right]
        end note
        
        loop For each event source
            Master -> Src1: snapshot_state() at t_left
            activate Src1
            Src1 --> Master: snapshot saved
            deactivate Src1
            
            Master -> Src1: Capture frozen inputs
            Master -> Src1: Evaluate indicators at t_left
            activate Src1
            Src1 --> Master: indicators_left
            deactivate Src1
            
            Master -> Src1: **Trial step** to t_right
            activate Src1
            Src1 -> Src1: _do_step_internal(t_left, dt)
            Src1 -> Src1: evaluate_event_indicators()
            Src1 --> Master: indicators_right
            deactivate Src1
            
            Master -> Master: **Detect zero-crossings**\ncompare signs(indicators_left, indicators_right)
            
            Master -> Src1: **Restore** to t_left
            activate Src1
            Src1 -> Src1: restore_state(snapshot, t_left)
            Src1 -> Src1: set_inputs(frozen_cache)
            Src1 --> Master: restored
            deactivate Src1
        end
        
        Master -> Master: Collect all crossings:\n[(comp_name, event_name), ...]
    end
    
    alt #Technology No Events Detected
        note over Master
            **Event-Free Interval:**
            Execute standard Gauss-Seidel
        end note
        
        Master -> Master: Gauss-Seidel step\nfor ALL components\n[t_left, t_right]
        
        note over Master
            **Exit sub-stepping loop**
            (t_left reaches t_right)
        end note
        
    else #LightCoral Events Detected
        
        group #FFF4E6 Phase 3: Event Localization (Bisection)
            note over Master
                **Goal:** Find earliest event time
                t_event ∈ [t_left, t_right]
                using bisection with frozen inputs
            end note
            
            Master -> Master: Initialize:\nleft = t_left, right = t_right\nt_left_ref = t_left
            
            loop Bisection: max 50 iterations
                Master -> Master: mid = 0.5 * (left + right)
                
                Master -> Src1: Evaluate indicators at mid\n(from t_left_ref with frozen inputs)
                activate Src1
                Src1 -> Src1: restore → step → evaluate
                Src1 --> Master: indicators_mid
                deactivate Src1
                
                Master -> Master: **Detect crossings** in:\n[left, mid] and [mid, right]
                
                alt Single event in [left, mid] AND |indicator| ≤ tol
                    Master -> Master: **Converged!**\nt_event = mid\nExit bisection
                    
                else Events in [left, mid]
                    Master -> Master: Narrow to left half:\nright ← mid
                    
                else Events in [mid, right]
                    Master -> Master: Narrow to right half:\nleft ← mid
                    note over Master
                        **Update working state:**
                        snapshot at mid becomes
                        new reference (t_left_ref = mid)
                    end note
                end
                
                Master -> Master: Check termination:\nright - left ≤ 1e-10?
            end
            
            Master -> Master: Finalize t_event\nCollect all events at t_event
            
            note over Master
                **Restore ALL sources to t_left**
                (prepare for system-wide step)
            end note
            
            Master -> Src1: restore_state(snapshot_left, t_left)
            activate Src1
            deactivate Src1
            Master -> Src2: restore_state(snapshot_left, t_left)
            activate Src2
            deactivate Src2
        end
        
        group #E6F7FF Phase 4: Step System to Event Time
            note over Master
                **Gauss-Seidel execution:**
                Step ALL components [t_left, t_event]
            end note
            
            Master -> Src1: do_step(t_left, t_event - t_left)
            activate Src1
            Src1 -> Src1: Update outputs at t_event
            Src1 --> Master: Y(t_event) ready
            deactivate Src1
            
            Master -> Src2: do_step(t_left, t_event - t_left)
            activate Src2
            Src2 -> Src2: Update outputs at t_event
            Src2 --> Master: Y(t_event) ready
            deactivate Src2
            
            Master -> Listener: do_step(t_left, t_event - t_left)
            activate Listener
            Listener -> Listener: Update outputs at t_event
            Listener --> Master: Y(t_event) ready
            deactivate Listener
        end
        
        group #F0E6FF Phase 5: Event Handling (Superdense Time)
            note over Master
                **Superdense time iteration:**
                current_time = (t_event, 0)
                Handle events iteratively at
                (t_event, 0), (t_event, 1), ...
            end note
            
            loop While events exist AND micro < 100
                Master -> Master: Group events by listener:\n{listener: [event1, event2, ...]}
                
                Master -> Master: **Check commutativity:**\nAnnotations or dynamic verification
                
                note over Master
                    **Dispatch events to listeners**
                    via event connections
                end note
                
                Master -> Listener: handle_event([event_names], t_event)
                activate Listener
                Listener -> Listener: _handle_events_internal()
                note right
                    Examples:
                    - Invert velocity
                    - Reset integrator
                    - Reinitialize FMU
                end note
                Listener -> Listener: _update_output_states(t_event)
                Listener --> Master: event handled
                deactivate Listener
                
                opt Self-events (source handles own event)
                    Master -> Src1: handle_event([event_name], t_event)
                    activate Src1
                    Src1 -> Src1: _handle_events_internal()
                    Src1 --> Master: event handled
                    deactivate Src1
                end
                
                Master -> Master: **Prepare inputs** at t_event\n(resolve algebraic loops)
                
                Master -> Master: **Detect new events:**\nEvaluate indicators before/after handling
                
                alt New events triggered
                    Master -> Master: current_time ← (t_event, micro+1)
                    note over Master
                        **Event chain detected:**
                        Continue microstep iteration
                    end note
                    
                else No new events
                    Master -> Master: **Exit microstep loop**
                    note over Master
                        All events at t_event
                        have been processed
                    end note
                end
            end
            
            opt Microstep limit exceeded
                Master -> Master: **ERROR:**\nMaximum microsteps reached\n(potential Zeno behavior)
            end
        end
        
        group #E6FFE6 Phase 6: Continue Sub-Stepping
            Master -> Master: **Update for next interval:**\nt_left ← t_event
            
            note over Master
                **Loop continues:**
                Next iteration checks [t_event, t_right]
                for additional events
            end note
        end
        
    end
    
end

note over Master
    **Macro-step complete**
    when t_left ≥ t_right
end note

@enduml