@startuml Event_Handling_Detail

!include ../../includes/common_styling.puml

title Phase 5: Event Handling with Superdense Time

participant "Master\nAlgorithm" as Master
participant "Event Source" as Src #LightBlue
participant "Combi\n(source + listener)" as Combi #LightGreen
participant "Listener" as Listener #LightCoral

note over Master
    **Input from Phase 4:**
    - All components at t_event (real time)
    - initial_events = [(comp_name, event_name), ...]
    - Example: [("Source", "zero_crossing")]
end note

note over Master
    **Goal:**
    Handle events iteratively at superdense time
    (t_event, 0), (t_event, 1), ... until no new events
end note

== Initialization ==

Master -> Master: **Initialize superdense time:**
note over Master
    current_time = DenseTime(t=t_event, micro=0)
    event_pairs = initial_events
    all_handled_events = set()
end note

== Superdense Time Loop ==

loop While event_pairs exist AND current_time.micro < max_microsteps

    group #FFE6CC Record Events in History        
        loop For each event pair
            Master -> Master: system.history.record_event(\ncomp_name, event_name, current_time)
        end
        
        note over Master
            **Example:**
            ("Source", "zero_crossing", DenseTime(t=0.333, micro=0))
        end note
    end
    
    group #E8F8F5 Group Events by Listener
        
        Master -> Master: **Build event dispatch map:**        
        note over Master
            **Example from Case 2:**
            events_by_component = {"Combi": ["zero_crossing"], "Listener": []}
        end note
    end
    
    group #FFF4E6 Check Event Commutativity (if multiple events per listener)
        
        note over Master
            **Only for len(event_names) > 1**
        end note
        
        alt Method 1: Annotation-based
            Master -> Master: Check comp.event_commutativity
            note over Master
                {('v_invert', 'v_double'): True}
            end note
            
            alt All pairs commute
                note over Master #LightGreen
                    ✓ Verified via annotations
                end note
            else Non-commutative
                note over Master #FFCCCC
                    ✗ ERROR: Cannot handle simultaneously
                end note
            end
            
        else Method 2: Dynamic verification
            Master -> Listener: snapshot → test all permutations → compare states
            
            alt Order-independent result
                note over Master #LightGreen
                    ✓ Commutative (tested)
                end note
            else Order affects result
                note over Master #FFCCCC
                    ✗ ERROR: Non-commutative
                end note
            end
        end
    end
    
    group #E6F7FF Evaluate Indicators Before Handling
        
        loop For each event source
            Master -> Src: evaluate_event_indicators()
            activate Src
            Src --> Master: indicators_before[Src.name]
            deactivate Src
        end
    end
    
    group #F0E6FF Dispatch Events to Listeners
        
        loop For each (comp_name, event_name) in event_pairs
            Master -> Master: targets = system._event_targets_by_source[\n    (comp_name, event_name)\n]
            
            loop For each target_name in targets
                Master -> Combi: handle_event([event_name], t_event)
                activate Combi
                
                Combi -> Combi: _handle_events_internal([event_name], t_event)
                
                Combi -> Combi: _update_output_states(t_event, [event_name])
                
                Combi -> Combi: _record_outputs(t_event)
                
                Combi --> Master: event handled
                deactivate Combi
            end
        end
    end
    
    group #E6FFE6 Prepare Inputs After Handling
        
        Master -> Master: _prepare_inputs(system, t_event)
        
        note over Master            
            Ensures consistency before detecting new events
        end note
    end
    
    group #FFF0E6 Evaluate Indicators After Handling
        
        loop For each event source
            Master -> Combi: evaluate_event_indicators()
            activate Combi
            Combi --> Master: indicators_after[Combi.name]
            deactivate Combi
        end
    end
    
    group #E8F8F5 Detect New Events Triggered by Handlers
        
        Master -> Master: new_events = []
        
        loop For each event source component
            Master -> Master: **Detect crossings:**\nevents = comp.detect_event_crossing(\n    indicators_before[comp.name],\n    indicators_after[comp.name]\n)
            
            loop For each detected event_name
                Master -> Master: event_pair = (comp.name, event_name)
                
                alt event_pair not in all_handled_events
                    Master -> Master: new_events.append(event_pair)
                end
            end
        end
        
        note over Master
            **Example from Case 2:**
            new_events = [("Combi", "v_change")] → handled at (t_event, 1)
        end note
    end
    
    group #F0E6FF Advance Microstep or Exit
        
        alt new_events exist
            Master -> Master: **Event chain detected!**
            note over Master #LightCoral
                event_pairs = new_events
                current_time = (t_event, micro+1)
            end note

        else No new events
            note over Master #LightGreen
                Exit microstep loop
            end note
        end
    end
    
end

== Termination Check ==

alt current_time.micro >= max_microsteps
    note over Master #FFCCCC
        **ERROR: Zeno Behavior**
    end note
    Master -> Master: Raise RuntimeError
end

== Finalization ==

Master -> Master: t_left ← t_event

== Return to Master ==

@enduml