@startuml Event_Localization_Detail

!include ../../includes/common_styling.puml

title Phase 3: Event Localization via Bisection

participant "Master\nAlgorithm" as Master
participant "Event Source 1" as Src1 #LightBlue
participant "Event Source 2" as Src2 #LightBlue

note over Master
    **Input from Phase 2:**
    - snapshots_left: {comp → state at t_left}
    - input_cache: {comp → frozen inputs}
    - indicators_left: {comp → {event → g_i(t_left)}}
    - crossings: [(comp, event), ...]
    - Interval: [t_left, t_right]
end note

note over Master
    **Goal:**
    Find earliest event time t_event ∈ [t_left, t_right]
    where indicator crosses zero: g_i(t_event) ≈ 0
end note

== Initialization ==

Master -> Master: **Initialize bisection variables:**
note over Master
    t_event = t_right    (default if no convergence)
    working_snapshots = snapshots_left.copy()
end note

Master -> Master: **Evaluate indicators at t_right**

loop For each event source
    Master -> Src1: restore_state(snapshots_left[Src1], t_left)
    activate Src1
    deactivate Src1
    
    Master -> Src1: set_inputs(input_cache[Src1], t_left)
    
    Master -> Src1: do_step(t_left, t_right - t_left)
    activate Src1
    Src1 -> Src1: _do_step_internal(t_left, dt)
    Src1 -> Src1: _update_output_states()
    deactivate Src1
    
    Master -> Src1: evaluate_event_indicators()
    activate Src1
    Src1 --> Master: indicators_right[Src1]
    deactivate Src1
end

== Bisection Loop ==

loop iteration = 1 to max_iter (50)

    group #FFE6CC Termination Check
        Master -> Master: **Check interval width:**\nright - left ≤ tol_time?
        
        alt Interval sufficiently small
            Master -> Master: **Converged by time tolerance!**\nt_event = right
            note over Master #LightGreen
                **Exit bisection loop**
                Interval narrowed to [t_event - 1e-10, t_event]
            end note
        end
    end
    
    group #E8F8F5 Bisection Step
        
        Master -> Master: **Compute midpoint:**\nmid = 0.5 * (left + right)
        
        note over Master
            **Evaluate indicators at mid**
            starting from working_snapshots at t_left_ref
            using frozen inputs from input_cache
            (see iteration loop above)
        end note

        Master -> Master: **Evaluate indicators at t_right**
        
    end
    
    group #FFF4E6 Crossing Detection in Sub-Intervals
        
        Master -> Master: **Detect crossings in [left, mid]:**
        note over Master
            events_left = _detect_crossing_between(
                event_sources, indicators_left, indicators_mid)
        end note
        
        Master -> Master: **Detect crossings in [mid, right]:**
        note over Master
            events_right = _detect_crossing_between(
                event_sources, indicators_mid, indicators_right)
        end note
        
        note over Master
            **Strategy:**
            - If single event in [left, mid] with |g| ≤ tol → converged
            - If multiple events in [left, mid] → narrow to left half
            - If no events in [left, mid] → narrow to right half
        end note
        
    end
    
    group #E6F7FF Interval Narrowing Decision
        
        alt Single event in [left, mid] AND |indicator_mid| ≤ tol_value
            
            Master -> Master: **Exact convergence!**
            note over Master #LightGreen                
                **t_event = mid**
                Exit bisection loop
            end note
            
        else Multiple events in [left, mid]
            
            Master -> Master: **Narrow to left half:**
            note over Master
                Multiple events detected in [left, mid] → earliest event must be in this interval
                **Update boundaries:**
                right ← mid, indicators_right ← indicators_mid
                **Keep same reference:**
                t_left_ref remains unchanged, working_snapshots unchanged
            end note
            
        else No events in [left, mid] → events in [mid, right]
            
            Master -> Master: **Narrow to right half:**
            note over Master
                No events in [left, mid] → event must be in [mid, right]
                **Update boundaries:**
                left ← mid, indicators_left ← indicators_mid
                **Update working state**
                t_left_ref ← mid
            end note
            
            loop For each event source
                Master -> Src1: **Create new working snapshot at mid**
                activate Src1
                Src1 -> Src1: snapshot_state()
                Src1 --> Master: working_snapshots[Src1] = snapshot
                deactivate Src1
            end
            
            Master -> Master: **Update default event time:**\nt_event = right
            
        end
        
    end
    
end

note over Master #FFCCCC
    **If max_iter reached without convergence:**
    Use t_event = right (last right boundary)
end note

== Finalization ==

group #F0E6FF Collect All Events at t_event

    note over Master
        **Multiple events may occur at same t_event**
    end note
    
    Master -> Master: all_events_at_t = []
    
    loop For each event source
        Master -> Src1: **Evaluate indicators at current state**\n(already at t_event from last iteration)
        activate Src1
        Src1 -> Src1: evaluate_event_indicators()
        Src1 --> Master: indicators
        deactivate Src1
        
        Master -> Master: **Collect events with |g_i| ≤ tol_value:**
        note over Master
            for event_name, value in indicators[Src1].items():
                if abs(value) ≤ 1e-8:
                    all_events_at_t.append((Src1, event_name))
        end note
    end
    
    note over Master
        **Example result:**
        all_events_at_t = [("Pendulum", "wall_hit"), ("Source_1", "zero_crossing")]
        Both treated as simultaneous at t_event (to be handled in Phase 5 superdense time)
    end note

end

group #E6FFE6 Restore All Components to t_left

    note over Master #CCFFCC
        **Restore to original t_left**
        Phase 4 will step ALL components from t_left to t_event.
        Event sources must be at t_left, not at t_event.
    end note
    
    loop For each event source
        Master -> Src1: restore_state(snapshots_left[Src1], t_left)
        activate Src1
        deactivate Src1
        
        Master -> Src1: set_inputs(input_cache[Src1], t_left)
    end

end

== Return to Master ==

Master -> Master: **Return localization result:**
note over Master
    **Returns:**
    1. dense_time = DenseTime(t=t_event, micro=0)
    2. all_events_at_t = [(comp_name, event_name), ...]
    
    **Next Phase:**
    → Phase 4: Step all components [t_left, t_event]
    → Phase 5: Handle events at (t_event, 0), (t_event, 1), ...
end note

@enduml