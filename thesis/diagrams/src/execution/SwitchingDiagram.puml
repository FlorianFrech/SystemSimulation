@startuml MasterPendulumSwitching

' Color scheme - clean white background
skinparam backgroundColor white
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxMessageSize 300
skinparam participantPadding 100
skinparam wrapWidth 0
skinparam maxMessageSize 500

participant System
participant PendulumMultiComp as Multi
participant "OpenSim Model" as OpenSim
participant "FEM Model" as FEM
participant Hysteresis

== Time Step Execution ==
note over Multi
  **New Active State:**
  active_mode = "OpneSim"
  active_comp = OpenSim Model
end note
System -> Multi: do_step(t=0.05, dt=0.01)
activate Multi

Multi -> Multi: _do_step_internal(t, dt)
note right: Base class method from\nMultiComponent

== Mode Selection ==
Multi -> Multi: mode_selector(t, state)
activate Multi
Multi -> Multi: _time_based_mode_selector(t, state)
note right: Subclass implementation\nReturns "FEM"

Multi --> Multi: proposed_mode = "FEM"
deactivate Multi

== Hysteresis Check ==
Multi -> Hysteresis: can_switch(t, "FEM")
activate Hysteresis
Hysteresis -> Hysteresis: Check if proposed_mode != last_mode
Hysteresis -> Hysteresis: Check dwell_time elapsed
Hysteresis --> Multi: True (switch allowed)
deactivate Hysteresis

== Mode Switch Execution ==
Multi -> Multi: _switch_mode("FEM", t=0.05)
activate Multi

Multi -> OpenSim: get_state()
Note right: Retrieve current state from\ncurrently active component
activate OpenSim
OpenSim --> Multi: {'q': {...}, 'omega': {...}, 'alpha': {...}, 'torque': {...}}
deactivate OpenSim

' Step 2: Adapt state
Multi -> Multi: _adapt_state(current_state, "FEM")
note right: PendulumMultiComp implementation:\nFEM uses standard format (no change)\nEQB would map q→q0, omega→omega0
Multi --> Multi: adapted_state (unchanged for FEM)

' Step 3: Set state in new component
Multi -> FEM: set_state(adapted_state, t=0.05)
activate FEM
note right
    Extract values,
    compute rotation matrix,
    transform to FEM coordinates
    Update grid functions: gf_u, gf_v, gf_a
    Apply torque:\nset_drive_torque(...)
end note

FEM --> Multi: State initialized
deactivate FEM

' Step 4: Update active component
Multi -> Multi: active_mode = "FEM"
Multi -> Multi: active_comp = FEM

' Step 4.5: Verify state consistency
Multi -> FEM: get_state()
activate FEM
note right: Compute rigid body kinematics\nfrom grid functions
FEM --> Multi: {'q': {'value': 0.0087, 'unit': 'rad'},\n'omega': {'value': 0.173, 'unit': 'rad/s'},\n'alpha': {'value': 100.86, 'unit': 'rad/s^2'},\n'torque': {'value': 1.0, 'unit': 'N*m'}}
deactivate FEM

' Step 5: Record switch
Multi -> Hysteresis: record_switch(t=0.05, "FEM")
activate Hysteresis
Hysteresis -> Hysteresis: last_switch_time = 0.05
Hysteresis -> Hysteresis: last_mode = "FEM"
Hysteresis --> Multi: switch recorded
deactivate Hysteresis

deactivate Multi

== Execute Active Component ==
Multi -> FEM: do_step(t=0.05, dt=0.01)
activate FEM
FEM -> FEM: _do_step_internal(t, dt)
note right: NGSolve nonlinear solver\nNewtonMinimization\nNewmark time integration
FEM --> Multi: step complete
deactivate FEM

== Update Outputs ==
Multi -> FEM: _update_output_states(t=0.06)
activate FEM
FEM -> FEM: update output port states
FEM --> Multi: outputs updated
deactivate FEM

Multi -> Multi: Copy outputs from active_comp
note right: for name in output_specs:\n  self.outputs[name].set(\n    active_comp.outputs[name].get(), t)

Multi --> System: step complete
deactivate Multi

@enduml