<cfsMaterialDataBase xmlns="http://www.cfs++.org/material"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.cfs++.org/material 
https://opencfs.gitlab.io/cfs/xml/CFS-Material/CFS_Material.xsd" >

   <material name="steel">
    <mechanical>
      <density>
        <linear>
          <real>7850</real> <!-- Density of steel in kg/m^3 -->
        </linear>
      </density>
      <elasticity>
        <linear>
          <isotropic>
            <elasticityModulus>
              <real>21000000000</real> <!-- Elasticity modulus of steel in Pa -->
            </elasticityModulus>
            <poissonNumber>
              <real>0.3</real> <!-- Poisson's ratio of steel -->
            </poissonNumber>
          </isotropic>
        </linear>
      </elasticity>
    </mechanical>
  </material>
</cfsMaterialDataBase>
