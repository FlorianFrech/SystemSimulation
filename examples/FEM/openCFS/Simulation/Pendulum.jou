reset

#---------------------------------------------------------------------------------------------------------------------
# Geometry parameters
#{r_rod = 0.01}
#{r_head = 0.040}
#{length = 0.400}
# {q0 = 45}
#{wall_len = 0.2}
#{wall_thk = 0.01}

#---------------------------------------------------------------------------------------------------------------------
# Define Geometry for pendulum
create sphere radius {r_head}
create cylinder height {length} radius {r_rod}

move volume 1 location 0 0 {-length} include_merged
move volume 2 z {-length/2} include_merged

unite body 1 2

webcut volume 1 with plane xplane offset 0 imprint merge

rotate volume all angle 90 about z include_merged
rotate volume all angle 45 about x include_merged

# Define Geometry for Wall
brick x {wall_len} y {wall_len} z {wall_thk}
move volume 4 y {-length} z {r_head + wall_thk/2}

#---------------------------------------------------------------------------------------------------------------------

# Export Right part
#delete volume 3
#delete volume 4
#export step "/home/florian/Documents/ContactModel/Geometry/Pendulum_L.stp" overwrite

# Export Left part
#delete volume 1
#delete volume 4
#export step "/home/florian/Documents/ContactModel/Geometry/Pendulum_R.stp" overwrite

# Export Wall
#delete volume 1
#delete volume 3
#export step "/home/florian/Documents/ContactModel/Geometry/Wall.stp" overwrite

volume 1 3 4 scheme tetmesh
mesh volume all

block 1 add volume 1 3
block 1 name "V_pendulum"

block 2 add volume 4
block 2 name "V_wall"

nodeset 1 add surface 12
nodeset 1 name "S_contact_pendulum"

nodeset 2 add surface 16
nodeset 2 name "S_contact_wall"

nodeset 3 add curve 5
nodeset 3 name "S_rotation_axis"

nodeset 4 add surface 17 18 19 20
nodeset 4 name "S_wall_fix"

save cub5 "/home/florian/Documents/ContactModel/Geometry/pendulum.cub5" overwrite journal
export ansys cdb "/home/florian/Documents/ContactModel/Simulation/PendulumWallImpact.cdb" geometry overwrite