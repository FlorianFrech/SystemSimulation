reset

# Geometry parameters
#{r_rod = 0.015}
#{r_head = 0.040}
#{length = 0.400}
# {q0 = 45}

# Define rod as cylinder
create cylinder height 0.4 radius 0.015
move volume 1 z 0.2 include_merged

# Define head as sphere
create sphere radius 0.04

unite body 1 2

webcut body 1 with plane yplane offset 0 imprint merge group_results

rotate volume 1 2 angle 90 about z include_merged
rotate volume 1 2 angle 90 about x include_merged
rotate volume 1 2 angle -45 about x include_merged

export step "/home/florian/Documents/ContactModel/Simulation/Pendulum.stp" overwrite