digraph SystemBlockDiagram {
	graph [fontname=Helvetica fontsize=12 nodesep=0.5 pad=0.1 rankdir=LR ranksep=0.75 splines=ortho]
	node [color="#3b82f6" fillcolor=white fontname=Helvetica penwidth=1.5 shape=record style="rounded,filled"]
	edge [arrowsize=0.7 color="#111827" fontname=Helvetica fontsize=10 penwidth=1.2]
	subgraph cluster_Reference {
		bgcolor="#dbeafe" color="#9ca3af" fontname=Helvetica fontsize=12 label=Reference style=rounded
		"Reference Trajectory" [label="{ Reference Trajectory }"]
		"Reference Angle Sensor" [label="{ Reference Angle Sensor }"]
	}
	subgraph cluster_Sensing {
		bgcolor="#dcfce7" color="#9ca3af" fontname=Helvetica fontsize=12 label=Sensing style=rounded
		"State Angle Sensor" [label="{ State Angle Sensor }"]
	}
	subgraph cluster_Control {
		bgcolor="#fee2e2" color="#9ca3af" fontname=Helvetica fontsize=12 label=Control style=rounded
		"PID Controller" [label="{ PID Controller }"]
	}
	subgraph cluster_Actuation {
		bgcolor="#fef3c7" color="#9ca3af" fontname=Helvetica fontsize=12 label=Actuation style=rounded
		Drive [label="{ Drive }"]
	}
	subgraph cluster_Plant {
		bgcolor="#e5e7eb" color="#9ca3af" fontname=Helvetica fontsize=12 label=Plant style=rounded
		Pendulum [label="{ Pendulum }"]
	}
	"Reference Trajectory" -> "Reference Angle Sensor" [label="ref θ(t)" style=solid]
	"Reference Angle Sensor" -> "PID Controller" [label=U_ref style=solid]
	Pendulum -> "State Angle Sensor" [label="θ (state)" style=solid]
	"State Angle Sensor" -> "PID Controller" [label=U_meas style=solid]
	"PID Controller" -> Drive [label="u (control)" style=solid]
	Drive -> Pendulum [label="τ (torque)" style=solid]
	Pendulum -> Drive [label="ω (feedback)" style=dashed]
	subgraph cluster_Legend {
		bgcolor="#ffffff" color="#9ca3af" fontname=Helvetica fontsize=12 label=Legend style=rounded
		LegendSignals [label="{ Signals | ref θ(t): reference | θ_ref: reference angle | θ_meas: measured angle | u: control | τ: torque | ω: angular velocity }" color="#6b7280" fillcolor=white shape=record]
		LegendStyles [label="{ Styles | solid: forward flow | dashed: feedback }" color="#6b7280" fillcolor=white shape=record]
	}
}
