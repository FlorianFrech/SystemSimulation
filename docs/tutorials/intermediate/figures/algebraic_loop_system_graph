// System: Algebraic Loop System
digraph {
	graph [bgcolor=white compound=true esep=0 fontname="Helvetica-Bold" fontsize=18 label="Algebraic Loop System" labelloc=t margin=0.2 nodesep=0.8 pad=0.5 rankdir=LR ranksep=0.8 sep=0 splines=true]
	node [fillcolor=white fontname=Helvetica fontsize=10 margin="0.05,0.05" shape=plaintext style=""]
	edge [arrowhead=vee arrowsize=0.7 arrowtail=none color="#111827" dir=forward fontname=Helvetica fontsize=10 labelangle=45 labelfontcolor="#374151" minlen=1.2 penwidth=1.2]
	subgraph cluster_legend {
		bgcolor="#f9fafb" color="#d1d5db" fontname="Helvetica-Bold" fontsize=10 label=Legend margin=8 penwidth=1.5 rank=sink style=rounded
		legend_node [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="2">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>Edges:</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">───&gt; Data flow</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#ef4444">───&gt; Algebraic loop</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#0b84ff">┄┄┄o Event connection</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>Ports:</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#ef4444"><B>red</B></FONT> Direct feedthrough</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#0b84ff"><B>blue</B></FONT> Event port</TD></TR>
    </TABLE>
    > fontsize=8 shape=plaintext]
	}
	subgraph cluster_Source {
		bgcolor="#dbbcc4" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Source margin=12 penwidth=2 style=rounded
		ConstSource [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD></TD><TD><B>ConstSource</B><BR/><FONT POINT-SIZE="8">#0</FONT></TD><TD PORT="y">y</TD></TR></TABLE>>]
	}
	subgraph "cluster_Algebraic Loop" {
		bgcolor="#bccce0" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label="Algebraic Loop" margin=12 penwidth=2 style=rounded
		InnerSubtractor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="neg">neg</TD></TR><TR><TD PORT="pos">pos</TD></TR></TABLE></TD><TD><B>InnerSubtractor</B><BR/><FONT POINT-SIZE="8">#2</FONT></TD><TD PORT="diff"><FONT COLOR="#ef4444"><B>diff</B></FONT></TD></TR></TABLE>>]
	}
	subgraph cluster_Feedback {
		bgcolor="#d0e4d7" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Feedback margin=12 penwidth=2 style=rounded
		OuterSubtractor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD PORT="neg">neg</TD></TR><TR><TD PORT="pos">pos</TD></TR></TABLE></TD><TD><B>OuterSubtractor</B><BR/><FONT POINT-SIZE="8">#1</FONT></TD><TD PORT="diff"><FONT COLOR="#ef4444"><B>diff</B></FONT></TD></TR></TABLE>>]
	}
	subgraph cluster_Integrator {
		bgcolor="#e9cfe3" color="#d1d5db" fontname="Helvetica-Bold" fontsize=11 label=Integrator margin=12 penwidth=2 style=rounded
		Integrator [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>in</TD><TD>name</TD><TD>out</TD></TR><TR><TD PORT="u">u</TD><TD><B>Integrator</B><BR/><FONT POINT-SIZE="8">#0</FONT></TD><TD PORT="y">y</TD></TR></TABLE>>]
	}
	ConstSource -> OuterSubtractor [label="" color="#111827" headclip=true headport="pos:w" penwidth=1.2 style=solid tailclip=true tailport="y:e"]
	OuterSubtractor -> InnerSubtractor [label="" color="#111827" headclip=true headport="pos:w" penwidth=1.2 style=solid tailclip=true tailport="diff:e"]
	InnerSubtractor -> Integrator [label="" color="#111827" headclip=true headport="u:w" penwidth=1.2 style=solid tailclip=true tailport="diff:e"]
	InnerSubtractor -> InnerSubtractor [label="" color="#ef4444" headclip=true headport="neg:w" penwidth=2.0 style=solid tailclip=true tailport="diff:e"]
	Integrator -> OuterSubtractor [label="" color="#111827" headclip=true headport="neg:w" penwidth=1.2 style=solid tailclip=true tailport="y:e"]
}
