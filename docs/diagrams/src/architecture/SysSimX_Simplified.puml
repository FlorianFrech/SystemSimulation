@startuml SysSimX_Simplified

!define ABSTRACT_CLASS abstract class

' ============================================================================
' STYLING
' ============================================================================

skinparam classAttributeIconSize 0
skinparam padding 2
skinparam defaultFontSize 9
skinparam classFontSize 10
skinparam nodesep 30
skinparam ranksep 30
skinparam backgroundColor white
skinparam shadowing false
hide empty members

skinparam package {
    BackgroundColor<<core>> #E6F3FF
    BorderColor<<core>> #4A90E2

    BackgroundColor<<components>> #E8F5E9
    BorderColor<<components>> #66BB6A

    BackgroundColor<<system>> #F3E5F5
    BorderColor<<system>> #AB47BC

    BackgroundColor<<algorithms>> #FFF3E0
    BorderColor<<algorithms>> #FFA726

    BackgroundColor<<viz>> #E0F7FA
    BorderColor<<viz>> #26C6DA
}

left to right direction

' ============================================================================
' CORE CONCEPTS
' ============================================================================

package "Core" <<core>> {
    class PortSpec {
        + name: str
        + type: PortType
        + direction: in|out
        + unit: Optional[str]
    }

    class PortState {
        + spec: PortSpec
        + value: Any
        + t_last: Optional[float]
        --
        + set(value, t)
        + get(as_unit=None)
    }

    ABSTRACT_CLASS CoSimComponent <<abstract>> {
        + name: str
        + inputs: Dict[str, PortState]
        + outputs: Dict[str, PortState]
        + parameters: Dict[str, Any]
        --
        + initialize(t0)
        + do_step(t, dt)
        + set_inputs(signals, t=None)
        + get_outputs()
        + get_history()
    }

    ABSTRACT_CLASS MultiComponent <<abstract>> {
        + models: Dict[str, CoSimComponent]
        + active_mode: str
        --
        + switch_mode(name, t)
        + _adapt_state(state, target)
    }

    MultiComponent -down-|> CoSimComponent
    CoSimComponent o-- "many" PortState
    PortState o-- PortSpec
}

package "Component Types" <<components>> {
    class FMUComponent {
        + fmu_path: str
        + model_description: Any
        --
        + set_parameters(**params)
        + _do_step_internal(t, dt)
    }

    class FEMComponent
    class OpenSimComponent

    FMUComponent -down-|> CoSimComponent
    FEMComponent -down-|> CoSimComponent
    OpenSimComponent -down-|> CoSimComponent
}

package "System" <<system>> {
    class Connection <<dataclass>> {
        + src_comp: str
        + src_port: str
        + dst_comp: str
        + dst_port: str
        + delay: int = 0
        + unit: Optional[str]
    }

    class System {
        + components: Dict[str, CoSimComponent]
        + connections: List[Connection]
        + execution_order: List[List[str]]
        + algebraic_loops: List[List[str]]
        --
        + add_component(comp)
        + add_connection(conn)
        + initialize(t0)
        + run(t0, tf, dt)
    }

    System o-right- "many" CoSimComponent
    System o- "many" Connection
}

package "Algorithms" <<algorithms>> {
    ABSTRACT_CLASS Algorithm <<abstract>> {
        + name: str
        --
        + step(system, t, dt)
    }

    class JacobiAlgorithm
    class GaussSeidelAlgorithm
    class HybridAlgorithm

    JacobiAlgorithm -down-|> Algorithm
    GaussSeidelAlgorithm -down-|> Algorithm
    HybridAlgorithm -down-|> Algorithm
}

package "Visualization" <<viz>> {
    class SystemGraphVisualizer {
        + visualize()
    }
}

System --> Algorithm : uses
SystemGraphVisualizer ..> System : renders

' Force left-to-right layout
"Component Types" -[hidden]down- "Core"
"System" -[hidden]down- "Component Types"
"Algorithms" -[hidden]right- "System"
"Visualization" -[hidden]right- "Algorithms"

@enduml
