@startuml Hybrid_Algorithm

skinparam backgroundColor white
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxMessageSize 300
skinparam participantPadding 100
skinparam wrapWidth 0
skinparam maxMessageSize 500

participant "Master/Orchestrator" as Master
participant "Event Source 1\n(rollback capable)" as Source1
participant "Event Source 2\n(rollback capable)" as Source2
participant "Event Listener" as Listener

== Hybrid Co-Simulation: One Step [t, t+dt] ==

note over Master: **Phase 1: Prepare Inputs at t_left**
Master -> Source1: **Set inputs** from connections
activate Source1
Source1 --> Master: inputs set
deactivate Source1

Master -> Source2: **Set inputs** from connections
activate Source2
Source2 --> Master: inputs set
deactivate Source2

Master -> Listener: **Set inputs** from connections
activate Listener
note right: Inputs frozen for event detection
Listener --> Master: inputs set
deactivate Listener

alt Components in algebraic loop
    Master -> Source1: **Solve algebraic loop** (IJCSA)
    activate Source1
    note right: Interface-Newton iteration
    Source1 --> Master: converged
    deactivate Source1
end

note over Master: **Phase 2: Event Detection [t_left, t_right]**

loop For each event source
    Master -> Source1: **Save snapshot** at t_left
    activate Source1
    Source1 -> Source1: snapshot_state()
    Source1 --> Master: snapshot saved
    deactivate Source1
    
    Master -> Source1: **Capture inputs** at t_left
    activate Source1
    Source1 --> Master: input_cache
    deactivate Source1
    
    Master -> Source1: **Evaluate indicators** at t_left
    activate Source1
    Source1 -> Source1: evaluate_event_indicators()
    Source1 --> Master: indicators_left
    deactivate Source1
    
    Master -> Source1: **Trial step** to t_right
    activate Source1
    Source1 -> Source1: _do_step_internal(t_left, dt)
    Source1 -> Source1: evaluate_event_indicators()
    Source1 --> Master: indicators_right
    deactivate Source1
    
    Master -> Master: **Detect crossings**\ndetect_event_crossing(indicators_left, indicators_right)
    
    Master -> Source1: **Restore to t_left**
    activate Source1
    Source1 -> Source1: restore_state(snapshot, t_left)
    Source1 -> Source1: set_inputs(input_cache)
    Source1 --> Master: restored
    deactivate Source1
end

alt No events detected
    note over Master: **No Events: Normal Step**
    Master -> Master: Execute Gauss-Seidel step\nfor all components [t_left, t_right]
    
else Events detected
    note over Master: **Phase 3: Event Localization**
    note over Master: Goal: Find earliest event time t_event in [t_left, t_right]
    
    Master -> Master: Initialize bisection:\nleft=t_left, right=t_right\nt_left_ref=t_left (snapshot reference time)
    
    loop Bisection: max_iter iterations
        Master -> Master: mid = 0.5 * (left + right)
        
        loop For each event source
            Master -> Source1: **Restore to t_left_ref** and **step to mid**
            activate Source1
            Source1 -> Source1: restore_state(working_snapshot, t_left_ref)
            Source1 -> Source1: set_inputs(input_cache) [frozen]
            Source1 -> Source1: _do_step_internal(t_left_ref, mid - t_left_ref)
            Source1 -> Source1: evaluate_event_indicators()
            Source1 --> Master: indicators_mid
            deactivate Source1
        end
        
        Master -> Master: **Detect crossings**\nin [left, mid] and [mid, right]
        
        alt Single event in [left, mid] AND |indicator_mid| ≤ tol_value
            Master -> Master: **Converged!** Return mid as t_event
            note over Master: Exit bisection loop
            
        else Single/Multiple events in [left, mid]
            Master -> Master: Narrow to left half:\nright ← mid\nindicators_at_right ← indicators_mid
            
        else Events in [mid, right]
            Master -> Master: Narrow to right half:\nleft ← mid\nindicators_at_left ← indicators_mid
            
            note over Master: **Update reference state**
            loop For each event source
                Master -> Source1: **Take new snapshot at mid**
                activate Source1
                Source1 -> Source1: snapshot_state()
                Source1 --> Master: working_snapshot updated
                deactivate Source1
            end
            Master -> Master: t_left_ref ← mid
        end
        
        Master -> Master: Check termination:\nright - left ≤ tol_time?
    end
    
    Master -> Master: Determine final t_event\n(mid or right based on indicator values)
    
    note over Master: **Critical: Restore ALL sources to t_left**
    loop For each event source
        Master -> Source1: **Restore to t_left**
        activate Source1
        Source1 -> Source1: restore_state(snapshot_left, t_left)
        Source1 -> Source1: set_inputs(input_cache)
        Source1 --> Master: ready for system step
        deactivate Source1
    end
    
    note over Master: **Phase 4: Step ALL Components to t_event**
    note over Master: Gauss-Seidel execution order
    
    Master -> Source1: **Step to t_event**
    activate Source1
    Source1 -> Source1: do_step(t_left, t_event - t_left)
    Source1 -> Source1: Update outputs at t_event
    Source1 --> Master: Y(t_event) available
    deactivate Source1
    
    Master -> Source2: **Step to t_event**
    activate Source2
    Source2 -> Source2: do_step(t_left, t_event - t_left)
    Source2 -> Source2: Update outputs at t_event
    Source2 --> Master: Y(t_event) available
    deactivate Source2
    
    Master -> Listener: **Step to t_event**
    activate Listener
    Listener -> Listener: do_step(t_left, t_event - t_left)
    Listener -> Listener: Update outputs at t_event
    Listener --> Master: Y(t_event) available
    deactivate Listener
    
    note over Master: **Phase 5: Dispatch and Handle Events**
    
    loop For each detected event (comp_name, event_name)
        Master -> Master: Record event in history:\nsystem.history.record_event(comp_name, event_name, t_event)
        
        Master -> Master: Get event targets:\nsystem.get_event_targets(comp_name, event_name)
        
        alt Event target is Source1 (self-event)
            Master -> Source1: **Handle event** at t_event
            activate Source1
            note right: Event: (source=Source1, name=event_name, t=t_event)
            Source1 -> Source1: _handle_events_internal([event_name], t_event)
            note right: May reinitialize FMU\nwith new initial conditions
            Source1 -> Source1: _update_output_states(t_event, [event_name])
            Source1 --> Master: event handled, state updated
            deactivate Source1
        end
        
        alt Event target is Listener
            Master -> Listener: **Handle event** at t_event
            activate Listener
            note right: Event: (source=Source1, name=event_name, t=t_event)
            Listener -> Listener: _handle_events_internal([event_name], t_event)
            note right: May reset integrator,\nswap velocity, etc.
            Listener -> Listener: _update_output_states(t_event)
            Listener --> Master: event handled, state updated
            deactivate Listener
        end
    end
    
    note over Master: **Phase 6: Continue from t_event**
    
    Master -> Master: **Prepare inputs at t_event**\n(resolve algebraic loops if needed)
    
    Master -> Master: t_left ← t_event\nContinue loop: while t_left < t_right
end

note over Master: **Macro step complete when t_left ≥ t_right**

@enduml