@startuml OpenSimPendulum

' ============================================================================
' STYLING
' ============================================================================

skinparam classAttributeIconSize 0
skinparam padding 2
skinparam defaultFontSize 10
skinparam classFontSize 11
skinparam nodesep 30
skinparam ranksep 10

' Color scheme - clean white background
skinparam backgroundColor white

' Remove yellow/red default colors
skinparam shadowing false

' Force left-to-right layout
left to right direction

' ============================================================================
' OPENSIM PENDULUM CLASS
' ============================================================================

class OpenSimPendulum <<OpenSimComponent>> {
    + parameters: Dict[str, Any]
    --
    + coord: Optional[osim.Coordinate]
    + actuator: Optional[osim.CoordinateActuator]
    --
    - _with_contact: bool
    - _use_gravity: bool
    --
    + q0: float
    + omega0: float
    ==
    + __init__(name, group)
    .. Model Building ..
    - _build()
    .. Initialization ..
    + initialize(t0)
    .. Time Stepping ..
    # _do_step_internal(t, dt)
    .. I/O ..
    + set_inputs(signals, t)
    + get_outputs(): Dict
    # _update_output_states(t)
    .. State Management ..
    + set_state(state, t)
    + get_state(): Dict
    + reset()
    .. Configuration ..
    + set_parameters(**parameters)
    .. Export ..
    + save_model(file_path)
}

class "Parameter Sets" as Params <<4 dicts>> {
    MODEL_PARAMETERS
    • mass, r_head, length
    • use_gravity
    
    CONTACT_PARAMETERS
    • with_contact, stiffness
    • dissipation, friction coeffs
    
    INITIAL_CONDITIONS
    • q0, omega0
    
    SOLVER_PARAMETERS
    • internal_dt, IntegratorMethod
    • accuracy
}

class "OpenSim Library" as OSim <<package>> {
    .. Model Components ..
    + Model, Body, Ground
    + PinJoint, WeldJoint
    + Coordinate, CoordinateSet
    + CoordinateActuator
    .. Geometry ..
    + Sphere, Brick, Cylinder
    + PhysicalOffsetFrame
    .. Contact ..
    + ContactSphere
    + ContactHalfSpace
    + HuntCrossleyForce
    .. Simulation ..
    + Manager, State
    + IntegratorMethod
    .. Utilities ..
    + Vec3, Inertia
}

class "Port Specifications" as Ports <<2 dicts>> {
    INPUT_SPECS
    • torque REAL (N·m)
    
    OUTPUT_SPECS
    • q: REAL (rad)
    • omega: REAL (rad/s)
    • alpha: REAL (rad/s²)
}

' Relationships
OpenSimPendulum -up-> OSim : uses
OpenSimPendulum -down-> Params : configures
OpenSimPendulum -down-> Ports : defines

' Force 2x2 layout
Params -[hidden]right- Ports

' note right of OpenSimPendulum
'     **Single-DOF Pendulum (OpenSim)**
    
'     • Rigid multibody dynamics
'     • Pin joint at base
'     • Coordinate actuator for torque
'     • Optional contact with wall
'     • Optional gravity
'     • Runge-Kutta-Merson integrator
    
'     **Model Structure:**
'     Ground → Base (WeldJoint)
'     Base → Head (PinJoint)
' end note

' note bottom of Params
'     **Configuration Groups:**
    
'     All parameters organized by
'     category for easy management:
'     - Physical properties
'     - Contact mechanics
'     - Initial state
'     - Solver settings
' end note

' note bottom of OSim
'     **OpenSim/Simbody Integration:**
    
'     • Bodies with mass/inertia
'     • Joints define kinematics
'     • Forces (actuators, contact)
'     • Manager handles time integration
'     • State tracks configuration
    
'     **Realization Stages:**
'     Position → Velocity →
'     Dynamics → Acceleration
' end note

' note top of Ports
'     **Co-Simulation Interface:**
    
'     Compatible with FMU and
'     FEM pendulum models via
'     standard input/output ports
' end note

@enduml