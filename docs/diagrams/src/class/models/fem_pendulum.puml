@startuml FEMPendulum

' ============================================================================
' STYLING
' ============================================================================

skinparam classAttributeIconSize 0
skinparam padding 2
skinparam defaultFontSize 10
skinparam classFontSize 11
skinparam nodesep 30
skinparam ranksep 10

' Color scheme - clean white background
skinparam backgroundColor white

' Remove yellow/red default colors
skinparam shadowing false

' Force left-to-right layout
left to right direction

' ============================================================================
' FEM PENDULUM CLASS
' ============================================================================

class FEMPendulum <<FEMComponent>> {
    + parameters: Geo, Mat, Mesh, Init, Contact, Sim, Anim
    --
    + mass: float
    + inertia: float
    --
    - _mesh: Mesh
    - _V: VectorH1
    - _Q: NumberSpace
    - _fes: FESpace
    - _S: MatrixValued
    --
    - _gf_[x]: GridFunction (u, v, a)
    - _gf_[x]old: GridFunction (u, v, a)
    --
    - _gf_[x]_history: GridFunction (u, v, a)
    --
    - _material: NeoHookeanMaterial
    - _contact: ContactBoundary
    --
    - _torque_parameters: Parameters
    --
    - _with_contact: bool
    - _use_gravity: bool
    - _scene: Draw
    - _widgets: list
    ==
    + __init__(name, group)
    .. Initialization ..
    # _initialize_component(t0)
    material law, mesh, FE spaces, grid functions,
    contact, torque control, bilinear form
    .. Time Stepping ..
    # _do_step_internal(t, dt)
    .. I/O ..
    + set_inputs(signals, t)
    + get_outputs(): Dict
    # _update_output_states(t)
    + set_drive_torque(torque)
    .. State Management ..
    + set_state(state, t)
    + get_state(): Dict
    + reset()
    .. Diagnostics ..
    - _rigid_proxy(): (theta, omega, alpha)
    - _get_torque_diagnostics(return_force): float
    - _get_contact_gap_distance(): float
    .. Visualization ..
    + setup_simulation_diagnostics(qref)
    + visualize_state()
}

class "NGSolve Library" as NGS <<package>> {
    .. GridFunction ..
    + vec, components
    + Set(expr), Interpolate(expr)
    + AddMultiDimComponent(vec)
    .. ContactBoundary ..
    + gap, normal
    + Update(u, bfa, intorder, maxdist)
    + AddEnergy(expr, deformed)
    .. BilinearForm ..
    + Variation(expr)
    + Compile()
    .. Parameter ..
    + Set(value), Get(): float
    .. Other ..
    + Mesh, FESpace, VectorH1
    + NumberSpace, MatrixValued
    + Draw
}

class NeoHookeanMaterial {
    + E: float
    + nu: float
    + C: CF
    + energy_density: CF
    + sigma: CF
    --
    + __init__(E, nu)
}

class "Config Parameters" as Config <<7 dataclasses>> {
    GeometryParameters
    MaterialParameters 
    MeshParameters
    InitialConditionParameters
    ContactParameters
    SimulationParameters
    AnimationParameters
}

' Relationships - all horizontal
FEMPendulum -down-> NeoHookeanMaterial: creates
FEMPendulum -down-> NGS: manages
FEMPendulum -down-> Config: uses

' Force 2x2 layout
' NeoHookeanMaterial -[hidden]right- Config

@enduml