@startuml FMUComponent

skinparam classAttributeIconSize 0
skinparam padding 1
skinparam defaultFontSize 10
skinparam classFontSize 11

' ============================================================================
' FMU COMPONENT CLASS
' ============================================================================

class FMUComponent <<CoSimComponent>>{
    + state: Dict[str, Any]
    - _path: str
    - _md: ModelDescription
    - _md_vars: Dict[str, ModelVariable]
    - _instance: Optional[FMU2Slave]
    - _unzipdir: Optional[str]
    - _vrs_in: Dict[str, int]
    - _vrs_out: Dict[str, int]
    ==
    + __init__(name, fmu_path, group)
    .. Build ..
    - _build_port_specs()
    - _build_value_reference_map()
    .. Init ..
    # _initialize_component(t0)
    - _apply_parameters_starts()
    - _apply_input_starts()
    .. Config ..
    + set_parameters(**parameters)
    .. I/O ..
    + set_inputs(signals, t)
    + get_outputs()
    # _update_output_states(t)
    .. Step ..
    # _do_step_internal(t, dt)
    .. State ..
    + set_state(state, t)
    + get_state()
    + reset()
}

class ModelDescription <<fmpy>> {
    + guid: str
    + fmiVersion: str
    + modelVariables
    + coSimulation
}

class ModelVariable <<fmpy>> {
    + name: str
    + valueReference: int
    + causality: str
    + type: str
    + unit: Optional[str]
    + _python_type: type
}

class FMU2Slave <<fmpy>> {
    + instantiate()
    + setupExperiment(startTime)
    + enterInitializationMode()
    + exitInitializationMode()
    + doStep(t, dt)
    + setReal/Integer/Boolean/String()
    + getReal/Integer/Boolean/String()
    + reset()
}

' Layout: FMUComponent on left, everything else to the right
FMUComponent -right-> ModelDescription
FMUComponent -right-> FMU2Slave
ModelDescription -right-> ModelVariable

' Force vertical stacking on right side
' ModelDescription -[hidden]down- FMU2Slave

@enduml