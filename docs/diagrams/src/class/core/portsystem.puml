@startuml PortSystem

' ============================================================================
' STYLING
' ============================================================================

skinparam classAttributeIconSize 0
skinparam padding 2
skinparam defaultFontSize 10
skinparam classFontSize 11
skinparam nodesep 20
skinparam ranksep 20

' Color scheme - clean white background
skinparam backgroundColor white

' Remove yellow/red default colors
skinparam shadowing false

left to right direction

' ============================================================================
' PORT SYSTEM ARCHITECTURE
' ============================================================================

abstract class CoSimComponent <<ABC>> {
    + name: str
    + label: str
    + group: Optional[str] = None
    + t: float = 0.0
    --
    + input_specs: Dict[str, PortSpec]
    + output_specs: Dict[str, PortSpec]
    + inputs: Dict[str, PortState]
    + outputs: Dict[str, PortState]
    + parameters: Dict[str, Any]
    ==
    + __init__(name: str, label: Optional[str], group: Optional[str])
    --
    .. Port Management ..
    # _initialize_ports_from_specs(): None
    --
    .. Configuration ..
    + set_parameters(**parameters: Any): None
    --
    .. Lifecycle ..
    + initialize(t0: float): None
    + do_step(t: float, dt: float): None
    + set_inputs(signals: Dict[str, Any], t: Optional[float]): None
    + get_outputs(): Dict[str, Any]
    + reset(): None
    + free(): None
    --
    .. Abstract Hooks ..
    {abstract} # _initialize_component(t0: float): None
    {abstract} # _do_step_internal(t: float, dt: float): None
    {abstract} # _update_output_states(t: float): None
    {abstract} + set_state(state: Dict[str, Any], t: float): None
    {abstract} + get_state(): Dict[str, Any]
}

enum PortType <<Enum>> {
    REAL = "real"
    INT = "int"
    BOOL = "bool"
    STRING = "string"
}

enum Direction <<Literal>> {
    "in"
    "out"
}

class PortSpec<T> <<frozen>> {
    + name: str
    + type: PortType
    + direction: Direction
    + unit: Optional[str]
    + description: Optional[str]
    --
    + validate_value(value)
    + {static} compatible(s1, s2): bool
}

class PortState<T> {
    + spec: PortSpec[T]
    + value: Optional[Union[T, Quantity]]
    + t_last: Optional[float]
    + history: list[tuple[float, value]]
    --
    + set(value, t)
    + get(as_unit): value
}

class Quantity <<pint>> {
    magnitude
    units
}

' Relationships
PortState *-right-> PortSpec : wraps
PortSpec -down-> PortType : typed by
PortSpec -down-> Direction : direction
PortState .-left-.> Quantity : may use
CoSimComponent o-down-> "many" PortSpec : has specs
CoSimComponent o-down-> "many" PortState : has states

' Layout hints
' PortSpec -[hidden]up- Direction
' PortSpec -[hidden]down- PortState

' note top of CoSimComponent
'     **Port System Design Pattern**
    
'     Components maintain two registries:
'     1. **Specs** (immutable interface contract)
'     2. **States** (mutable runtime values)
    
'     Each PortState wraps a PortSpec
' end note

' note right of PortSpec
'     **Immutable Contract**
    
'     Defines port interface:
'     - Name and type
'     - Direction (in/out)
'     - Optional unit
'     - Validation rules
    
'     Created once during
'     component construction
' end note

' note right of PortState
'     **Mutable Runtime**
    
'     Tracks dynamic data:
'     - Current value
'     - Last update time
'     - Value history
    
'     Updated during
'     simulation steps
' end note

' note bottom of CoSimComponent
'     **Initialization Flow:**
    
'     1. Subclass populates input_specs/output_specs
'     2. _initialize_ports_from_specs() called
'     3. Creates PortState for each PortSpec
'     4. States added to inputs/outputs dicts
    
'     **Runtime Flow:**
    
'     set_inputs() → inputs[name].set(value, t)
'     do_step() → _do_step_internal()
'     _update_output_states() → outputs[name].set(value, t)
'     get_outputs() → {name: outputs[name].get()}
' end note

' note bottom of PortType
'     **Type System:**
    
'     Maps to Python types:
'     - REAL → float
'     - INT → int
'     - BOOL → bool
'     - STRING → str
    
'     Used for validation
'     and type checking
' end note

' note bottom of Quantity
'     **Unit Handling:**
    
'     Only for REAL ports:
'     - Automatic conversion
'     - Dimensional analysis
'     - Unit validation
    
'     From pint library
' end note

@enduml